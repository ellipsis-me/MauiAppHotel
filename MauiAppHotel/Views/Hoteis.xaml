<?xml version="1.0" 
    encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MauiAppHotel.Views.Hoteis"
             Title="Hoteis"
             NavigationPage.HasNavigationBar="False"
             BackgroundColor="{StaticResource Gray100}">

    <ScrollView>

        <VerticalStackLayout
            Padding="30"
            Spacing="25">

            <Label Text="Hotéis"
               TextColor="{StaticResource Primary}"
               FontFamily="Kalam"
               FontSize="50"
               HorizontalTextAlignment="Center"/>
            
            <Frame BackgroundColor="{StaticResource Gray300}">
                <VerticalStackLayout>
                    <Label
                        Text="Atlantis The Royal"
                        FontFamily="Kalam"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />
                    <Image
                        Source="hotel_1.jpg"
                        HeightRequest="185"
                        Aspect="AspectFill"
                        SemanticProperties.Description="A White Hotel" />
                </VerticalStackLayout>
            </Frame>
            
            <Frame BackgroundColor="{StaticResource Gray300}">
                <VerticalStackLayout>
                    <Label
                        Text="Kudadoo"
                        FontFamily="Kalam"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />
                    <Image
                        Source="hotel_2.jpg"
                        HeightRequest="185"
                        Aspect="AspectFill"
                        SemanticProperties.Description="A White Hotel" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource Gray300}">
                <VerticalStackLayout>
                    <Label
                        Text="Dolder Grand"
                        FontFamily="Kalam"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />
                    <Image
                        Source="hotel_3.jpg"
                        HeightRequest="185"
                        Aspect="AspectFill"
                        SemanticProperties.Description="A White Hotel" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource Gray300}">
                <VerticalStackLayout>
                    <Label
                        Text="Halekulani Okinawa"
                        FontFamily="Kalam"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />
                    <Image
                        Source="hotel_4.jpg"
                        HeightRequest="185"
                        Aspect="AspectFill"
                        SemanticProperties.Description="A White Hotel" />
                </VerticalStackLayout>
            </Frame>

            <Frame BackgroundColor="{StaticResource Gray300}">
                <VerticalStackLayout>
                    <Label
                        Text="Rosewood Miramar Beach"
                        FontFamily="Kalam"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />
                    <Image
                        Source="hotel_5.jpg"
                        HeightRequest="185"
                        Aspect="AspectFill"
                        SemanticProperties.Description="A White Hotel" />
                </VerticalStackLayout>
            </Frame>
            <Button Text="Voltar"
                HorizontalOptions="Center"
                Clicked="Button_Clicked" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>